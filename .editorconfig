root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,hpp,h,cc,cxx,mm,m,inl}]
indent_size = 4

[*.{metal,glsl,hlsl}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2
